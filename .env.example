# 复制本文件为 .env，再把你自己的 Key 填进去
# .env 已经在 .gitignore 里，不会被提交，Key 不会泄露

# 智谱开放平台：https://open.bigmodel.cn → 控制台 →  API Keys
# GLM-4-Flash 永久免费，注册后创建一个 Key 粘贴到下面
ZHIPU_API_KEY=your_zhipu_api_key_here

# 博查搜索：https://open.bochaai.com → 控制台 → API Key
# 新用户可免费领取 1000 次调用
BOCHA_API_KEY=your_bocha_api_key_here
